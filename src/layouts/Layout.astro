---
import "../styles/global.css";
import { Footer } from "../features/navigation";
import { ScrollToTop } from "../components/ui/scroll-to-top";
import { ClientRouter } from "astro:transitions";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
	canonical?: string;
	noindex?: boolean;
	publishedTime?: string;
	modifiedTime?: string;
	author?: string;
	keywords?: string[];
}

const siteUrl = "https://epg.unapiquitos.edu.pe";
const defaultTitle = "Escuela de Postgrado UNAP";
const defaultDescription = "Escuela de Postgrado de la Universidad Nacional de la Amazonía Peruana. Maestrías, Doctorados y Formación Continua de excelencia académica.";
const defaultImage = "/og-image.jpg";
const defaultKeywords = ["postgrado", "maestría", "doctorado", "UNAP", "Amazonía", "Perú", "educación superior", "universidad", "Iquitos"];

const {
	title = defaultTitle,
	description = defaultDescription,
	image = defaultImage,
	type = "website",
	canonical,
	noindex = false,
	publishedTime,
	modifiedTime,
	author = "Escuela de Postgrado UNAP",
	keywords = defaultKeywords,
} = Astro.props;

// Build full title with site name suffix (unless it's the homepage)
const fullTitle = title === defaultTitle ? title : `${title} | ${defaultTitle}`;

// Build canonical URL
const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).href;

// Build full image URL
const imageURL = image.startsWith("http") ? image : new URL(image, siteUrl).href;

// Keywords as string
const keywordsString = keywords.join(", ");
---

<!doctype html>
<html lang="es">
<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<ClientRouter />
		
		<!-- Favicon -->
		<link rel="icon" type="image/webp" href="/images/logo/Isotipo-EPG.webp" />
		<link rel="icon" type="image/webp" sizes="32x32" href="/images/logo/Isotipo-EPG.webp" />
		<link rel="apple-touch-icon" sizes="180x180" href="/images/logo/Isotipo-EPG.webp" />
		
		<!-- Google Fonts - Inter -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
		
		<!-- Primary Meta Tags -->
		<title>{fullTitle}</title>
		<meta name="title" content={fullTitle} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywordsString} />
		<meta name="author" content={author} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:alt" content={fullTitle} />
		<meta property="og:locale" content="es_PE" />
		<meta property="og:site_name" content="Escuela de Postgrado UNAP" />
		
		{type === "article" && publishedTime && (
			<meta property="article:published_time" content={publishedTime} />
		)}
		{type === "article" && modifiedTime && (
			<meta property="article:modified_time" content={modifiedTime} />
		)}
		{type === "article" && author && (
			<meta property="article:author" content={author} />
		)}
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />
		<meta name="twitter:image:alt" content={fullTitle} />
		
		<!-- Geo Tags for Local SEO -->
		<meta name="geo.region" content="PE-LOR" />
		<meta name="geo.placename" content="Iquitos" />
		<meta name="geo.position" content="-3.749220;-73.253830" />
		<meta name="ICBM" content="-3.749220, -73.253830" />
		
		<!-- Theme Color -->
		<meta name="theme-color" content="#0A1628" />
		<meta name="msapplication-TileColor" content="#0A1628" />
		
		<!-- Structured Data - Organization -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "EducationalOrganization",
			"name": "Escuela de Postgrado UNAP",
			"alternateName": "EPG UNAP",
			"url": siteUrl,
			"logo": `${siteUrl}/logo-epg.png`,
			"description": defaultDescription,
			"address": {
				"@type": "PostalAddress",
				"streetAddress": "Calle Nauta 5ta cuadra",
				"addressLocality": "Iquitos",
				"addressRegion": "Loreto",
				"postalCode": "16001",
				"addressCountry": "PE"
			},
			"telephone": "+51-65-232241",
			"email": "epg@unapiquitos.edu.pe",
			"parentOrganization": {
				"@type": "CollegeOrUniversity",
				"name": "Universidad Nacional de la Amazonía Peruana",
				"alternateName": "UNAP",
				"url": "https://www.unapiquitos.edu.pe"
			},
			"sameAs": [
				"https://www.facebook.com/EPGUNAP",
				"https://www.youtube.com/@EscueladePostgradoUNAP"
			]
		})} />
	</head>
	<body class="min-h-screen bg-background flex flex-col">
		<slot />
		<Footer client:load />
		<ScrollToTop client:load />
		<script>
			import "../scripts/scroll-reveal";
		</script>
	</body>
</html>
