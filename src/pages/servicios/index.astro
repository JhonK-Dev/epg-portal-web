---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../features/navigation/components/Navbar.astro';
import { ServiciosGrid } from '../../features/servicios';
---

<Layout 
  title="Servicios Digitales"
  description="Accede a las plataformas y servicios digitales de la Escuela de Postgrado UNAP. SIGAE, Aula Virtual, Biblioteca, Mesa de Partes y más."
  keywords={["servicios EPG UNAP", "plataformas digitales postgrado", "SIGAE", "aula virtual UNAP", "biblioteca virtual Iquitos"]}
>
  <Navbar />
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="bg-linear-to-br from-epg-navy via-epg-navy-light to-epg-navy-light text-white py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Espacio para mantener alineación visual tras eliminar breadcrumb -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 pt-32">Servicios Digitales</h1>
        <p class="text-xl text-gray-300 max-w-3xl leading-relaxed">
          Accede a las plataformas y servicios digitales de la Escuela de Postgrado desde un solo lugar.
        </p>
      </div>
    </section>

    <!-- Content -->
    <section class="py-12 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ServiciosGrid client:load />
      </div>
    </section>
  </main>
</Layout>
