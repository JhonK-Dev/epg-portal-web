---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../features/navigation';
import { ServiciosGrid } from '../../features/servicios';
---

<Layout 
  title="Servicios Digitales"
  description="Accede a las plataformas y servicios digitales de la Escuela de Postgrado UNAP. SIGAE, Aula Virtual, Biblioteca, Mesa de Partes y más."
  keywords={["servicios EPG UNAP", "plataformas digitales postgrado", "SIGAE", "aula virtual UNAP", "biblioteca virtual Iquitos"]}
>
  <Navbar client:load />
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-epg-navy via-epg-navy-light to-epg-navy-light text-white py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="text-sm mb-6">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="text-gray-300 hover:text-white transition-colors">Inicio</a></li>
            <li class="text-gray-400">/</li>
            <li class="text-epg-gold">Servicios</li>
          </ol>
        </nav>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Servicios Digitales</h1>
        <p class="text-xl text-gray-300 max-w-3xl leading-relaxed">
          Accede a las plataformas y servicios digitales de la Escuela de Postgrado desde un solo lugar.
        </p>
      </div>
    </section>

    <!-- Content -->
    <section class="py-12 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ServiciosGrid client:load />
      </div>
    </section>
  </main>
</Layout>
