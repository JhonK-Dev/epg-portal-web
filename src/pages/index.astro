---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../features/navigation';
import { 
  Hero, 
  ProgramSearch, 
  FeaturedPrograms,
  StatsSection,
  NewsAndEvents,
  AdmissionCTA
} from '../features/home';
---

<Layout 
  title="Escuela de Postgrado UNAP"
  description="Escuela de Postgrado de la Universidad Nacional de la Amazonía Peruana. Maestrías, Doctorados y Formación Continua de excelencia académica en Iquitos."
  keywords={["postgrado UNAP", "maestría Iquitos", "doctorado Amazonía", "universidad Iquitos", "educación superior Loreto"]}
>
  <Navbar client:load />
  <main>
    <!-- Hero Section con búsqueda y estadísticas -->
    <Hero client:load />
    
    <!-- Programas Destacados -->
    <FeaturedPrograms client:load />
    
    <!-- Búsqueda de Programas -->
    <ProgramSearch client:load />
    
    <!-- Estadísticas Institucionales -->
    <StatsSection client:load />
    
    <!-- Noticias y Eventos -->
    <NewsAndEvents client:load />
    
    <!-- CTA de Admisión -->
    <AdmissionCTA client:load />
  </main>
</Layout>
