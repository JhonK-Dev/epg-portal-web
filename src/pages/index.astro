---
import Layout from '../layouts/Layout.astro';
import Navbar from '../features/navigation/components/Navbar.astro';
import Hero from '../features/home/components/Hero.astro';
import FeaturedPrograms from '../features/home/components/FeaturedPrograms.astro';
import AdmissionCTA from '../features/home/components/AdmissionCTA.astro';
import { 
  ProgramSearchWithStats
} from '../features/home';
import { getFeaturedPrograms } from '../lib/api';
import { getProgramas } from '../data/programas';
import { getBusquedasPopulares } from '../data/busquedas-populares';
import { getEstadisticasInstitucionales } from '../data/estadisticas';
import type { ApiProgram } from '../lib/api/programs/types';
import { ErrorBoundary } from '../components/ui/error-boundary';


let apiPrograms: ApiProgram[] = [];
let hasError = false;
const programas = await getProgramas();
const busquedasPopulares = await getBusquedasPopulares();
const estadisticasInstitucionales = await getEstadisticasInstitucionales();

try {
  apiPrograms = await getFeaturedPrograms();
} catch (error) {
  console.error('Error fetching programs:', error);
  hasError = true;
}


const maestriasCount = apiPrograms.filter((p) => p.program_type === 1).length;
const doctoradosCount = apiPrograms.filter((p) => p.program_type === 2).length;
const formacionContinuaCount = 0; // La API no tiene este tipo aún
---

<Layout 
  title="Postgrado UNAP"
  description="Escuela de Postgrado de la Universidad Nacional de la Amazonía Peruana. Maestrías, Doctorados y Formación Continua de excelencia académica en Iquitos."
  keywords={["postgrado UNAP", "maestría Iquitos", "doctorado Amazonía", "universidad Iquitos", "educación superior Loreto"]}
>
  <Navbar />
  <main>
    <!-- Hero Section — Astro component, zero JS -->
    <Hero />
    
    <!-- Programas Destacados — Astro component, zero JS -->
    <div class="scroll-reveal">
      <FeaturedPrograms 
        programs={apiPrograms}
        maestriasCount={maestriasCount}
        doctoradosCount={doctoradosCount}
        formacionContinuaCount={formacionContinuaCount}
        hasError={hasError}
      />
    </div>
    
    <!-- Búsqueda de Programas + Estadísticas — React, hydrates when visible -->
    <ErrorBoundary client:load>
      <ProgramSearchWithStats
        client:visible
        programas={programas}
        busquedasPopulares={busquedasPopulares}
        estadisticasInstitucionales={estadisticasInstitucionales}
      />
    </ErrorBoundary>
    
    <!-- CTA de Admisión — Astro component, zero JS -->
    <AdmissionCTA />
  </main>
</Layout>
