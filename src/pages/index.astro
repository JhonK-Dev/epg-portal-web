---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../features/navigation';
import { 
  Hero, 
  ProgramSearchWithStats, 
  FeaturedPrograms,
  AdmissionCTA,
  ContactSection
} from '../features/home';
import { getActivePrograms } from '../lib/api';
import type { ApiProgram } from '../lib/api/programs/types';

let apiPrograms: ApiProgram[] = [];
let hasError = false;

try {
  apiPrograms = await getActivePrograms();
} catch (error) {
  console.error('Error fetching programs:', error);
  hasError = true;
}

const displayPrograms = apiPrograms.slice(0, 6).map((apiProgram) => ({
  id: apiProgram.uuid,
  nombre: apiProgram.name,
  tipo: apiProgram.program_type === 2 ? 'doctorado' as const : 'maestria' as const,
  descripcion: apiProgram.description,
  descripcionCorta: apiProgram.description.slice(0, 100) + '...',
  slug: apiProgram.uuid,
  imagen: apiProgram.background,
}));

const maestriasCount = apiPrograms.filter((p) => p.program_type === 1).length;
const doctoradosCount = apiPrograms.filter((p) => p.program_type === 2).length;
const formacionContinuaCount = 0; // La API no tiene este tipo aún
---

<Layout 
  title="Escuela de Postgrado UNAP"
  description="Escuela de Postgrado de la Universidad Nacional de la Amazonía Peruana. Maestrías, Doctorados y Formación Continua de excelencia académica en Iquitos."
  keywords={["postgrado UNAP", "maestría Iquitos", "doctorado Amazonía", "universidad Iquitos", "educación superior Loreto"]}
>
  <Navbar client:load />
  <main>
    <!-- Hero Section con búsqueda y estadísticas -->
    <Hero client:load />
    
    <!-- Programas Destacados - Server-side rendered -->
    <FeaturedPrograms 
      programs={displayPrograms}
      maestriasCount={maestriasCount}
      doctoradosCount={doctoradosCount}
      formacionContinuaCount={formacionContinuaCount}
      hasError={hasError}
    />
    
    <!-- Búsqueda de Programas + Estadísticas Institucionales -->
    <ProgramSearchWithStats client:load />
    
    <!-- CTA de Admisión -->
    <AdmissionCTA client:load />
    
    <!-- Formulario de Contacto -->
    <ContactSection client:load />
  </main>
</Layout>
