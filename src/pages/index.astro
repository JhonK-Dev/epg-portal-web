---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../features/navigation';
import { 
  Hero, 
  ProgramSearchWithStats, 
  FeaturedPrograms,
  AdmissionCTA,
  ContactSection
} from '../features/home';
import { getActivePrograms } from '../lib/api';
import type { ApiProgram } from '../lib/api/types';
import { programas } from '../data/programas';

let apiPrograms: ApiProgram[] = [];
let useFallback = false;

try {
  apiPrograms = await getActivePrograms();
} catch (error) {
  console.warn('API fetch failed, using fallback data:', error);
  useFallback = true;
}

const fallbackPrograms = programas
  .filter((p) => p.destacado)
  .slice(0, 6);

const fallbackDisplay = fallbackPrograms.length >= 6
  ? fallbackPrograms
  : [
      ...fallbackPrograms,
      ...programas
        .filter((p) => !p.destacado && p.estado === 'activo')
        .slice(0, 6 - fallbackPrograms.length),
    ];

const displayPrograms = useFallback 
  ? fallbackDisplay 
  : apiPrograms.slice(0, 6).map((apiProgram) => ({
      id: apiProgram.uuid,
      nombre: apiProgram.name,
      tipo: apiProgram.program_type === 2 ? 'doctorado' as const : 'maestria' as const,
      descripcion: apiProgram.description,
      descripcionCorta: apiProgram.description.slice(0, 100) + '...',
      duracion: 'Por definir',
      creditos: 0,
      modalidad: 'presencial' as const,
      estado: apiProgram.is_active ? 'activo' as const : 'inactivo' as const,
      slug: apiProgram.uuid,
      facultad: 'Escuela de Postgrado UNAP',
      imagen: apiProgram.background,
      destacado: true,
    }));

const maestriasCount = useFallback 
  ? programas.filter((p) => p.tipo === 'maestria' && p.estado === 'activo').length
  : apiPrograms.filter((p) => p.program_type === 1).length;

const doctoradosCount = useFallback 
  ? programas.filter((p) => p.tipo === 'doctorado' && p.estado === 'activo').length
  : apiPrograms.filter((p) => p.program_type === 2).length;

const formacionContinuaCount = useFallback 
  ? programas.filter((p) => (p.tipo === 'diplomado' || p.tipo === 'curso') && p.estado === 'activo').length
  : 0;
---

<Layout 
  title="Escuela de Postgrado UNAP"
  description="Escuela de Postgrado de la Universidad Nacional de la Amazonía Peruana. Maestrías, Doctorados y Formación Continua de excelencia académica en Iquitos."
  keywords={["postgrado UNAP", "maestría Iquitos", "doctorado Amazonía", "universidad Iquitos", "educación superior Loreto"]}
>
  <Navbar client:load />
  <main>
    <!-- Hero Section con búsqueda y estadísticas -->
    <Hero client:load />
    
    <!-- Programas Destacados - Server-side rendered -->
    <FeaturedPrograms 
      programs={displayPrograms}
      maestriasCount={maestriasCount}
      doctoradosCount={doctoradosCount}
      formacionContinuaCount={formacionContinuaCount}
    />
    
    <!-- Búsqueda de Programas + Estadísticas Institucionales -->
    <ProgramSearchWithStats client:load />
    
    <!-- CTA de Admisión -->
    <AdmissionCTA client:load />
    
    <!-- Formulario de Contacto -->
    <ContactSection client:load />
  </main>
</Layout>
