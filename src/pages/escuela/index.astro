---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../features/navigation/components/Navbar.astro';
import { EscuelaContent } from '../../features/escuela';
---

<Layout 
  title="La Escuela"
  description="Historia, misión, visión y valores de la Escuela de Postgrado de la UNAP. Más de 35 años formando líderes para la Amazonía peruana."
  keywords={["historia EPG UNAP", "sobre escuela postgrado", "misión visión UNAP", "autoridades EPG Iquitos"]}
>
  <Navbar />
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative bg-epg-navy text-white py-20 lg:py-28 overflow-hidden">
      <!-- Background Image -->
      <div class="absolute inset-0 z-0">
        <img
          src="/images/hero/Docx.jpeg"
          alt="Escuela de Postgrado UNAP"
          class="w-full h-full object-cover object-[center_20%]"
          loading="eager"
        />
        <div class="absolute inset-0 bg-linear-to-r from-epg-navy/95 via-epg-navy/80 to-epg-navy/60" />
        <div class="absolute inset-0 bg-linear-to-t from-epg-navy/60 via-transparent to-transparent" />
      </div>

      <!-- Content -->
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="text-sm mb-6">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="text-gray-300 hover:text-white transition-colors">Inicio</a></li>
            <li class="text-gray-400">/</li>
            <li class="text-epg-gold">La Escuela</li>
          </ol>
        </nav>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">La Escuela de Postgrado</h1>
        <p class="text-xl text-gray-300 max-w-3xl leading-relaxed">
          Más de 35 años formando líderes y profesionales de excelencia comprometidos con el desarrollo sostenible de la Amazonía peruana.
        </p>
      </div>
    </section>

    <!-- Quick Navigation: fixed - se ajusta dinámicamente cuando navbar se oculta -->
    <section
      id="escuela-tabs"
      class="fixed bg-white border-b z-40 w-full shadow-sm"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex overflow-x-auto gap-8 py-4 scrollbar-hide">
          <a href="#historia" class="text-epg-navy font-medium whitespace-nowrap hover:text-epg-gold transition-colors border-b-2 border-transparent hover:border-epg-gold pb-1">Historia</a>
          <a href="#mision-vision" class="text-gray-600 whitespace-nowrap hover:text-epg-gold transition-colors border-b-2 border-transparent hover:border-epg-gold pb-1">Misión y Visión</a>
          <a href="#valores" class="text-gray-600 whitespace-nowrap hover:text-epg-gold transition-colors border-b-2 border-transparent hover:border-epg-gold pb-1">Valores</a>
          <a href="#estadisticas" class="text-gray-600 whitespace-nowrap hover:text-epg-gold transition-colors border-b-2 border-transparent hover:border-epg-gold pb-1">Estadísticas</a>
          <a href="#autoridades" class="text-gray-600 whitespace-nowrap hover:text-epg-gold transition-colors border-b-2 border-transparent hover:border-epg-gold pb-1">Autoridades</a>
          <a href="#documentos" class="text-gray-600 whitespace-nowrap hover:text-epg-gold transition-colors border-b-2 border-transparent hover:border-epg-gold pb-1">Documentos</a>
        </nav>
      </div>
    </section>

    <!-- Spacer para compensar el tab menu fixed (responsivo) -->
    <div class="h-16 md:h-[108px]"></div>

    <!-- Content -->
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <EscuelaContent client:load />
      </div>
    </section>
  </main>

  <script>
    function initTabs() {
      const tabs = document.getElementById('escuela-tabs');
      if (!tabs) return;

      const TAB_TOP_VISIBLE = '4rem';      // 64px - mobile
      const TAB_TOP_VISIBLE_MD = '6.75rem'; // 108px - desktop
      const TAB_TOP_HIDDEN = '0px';

      let lastScrollY = 0;
      let ticking = false;

      function update() {
        const header = document.getElementById('main-header');
        if (!header) return;

        const isHidden = header.classList.contains('-translate-y-full');
        const isMd = window.innerWidth >= 768;

        tabs.style.top = isHidden 
          ? TAB_TOP_HIDDEN 
          : (isMd ? TAB_TOP_VISIBLE_MD : TAB_TOP_VISIBLE);

        ticking = false;
      }

      function onScroll() {
        lastScrollY = window.scrollY;
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    }

    initTabs();
    document.addEventListener('astro:after-swap', initTabs);
  </script>
</Layout>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
