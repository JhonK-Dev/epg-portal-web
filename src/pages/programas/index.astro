---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../features/navigation';
import { ProgramasLista } from '../../features/programas';
import { getPrograms } from '../../lib/api';
import type { ApiProgram } from '../../lib/api/programs/types';

// Get query parameters from URL
const url = new URL(Astro.request.url);
const searchQuery = url.searchParams.get('search') || '';
const programTypeParam = url.searchParams.get('program_type');
const programType = programTypeParam ? parseInt(programTypeParam, 10) : undefined;

let apiPrograms: ApiProgram[] = [];
let hasError = false;

try {
  const filters: { is_active?: boolean; program_type?: number; search?: string } = {
    is_active: true,
  };
  
  if (programType) {
    filters.program_type = programType;
  }
  
  if (searchQuery) {
    filters.search = searchQuery;
  }
  
  apiPrograms = await getPrograms(filters);
} catch (error) {
  console.error('Error fetching programs:', error);
  hasError = true;
}

// Calculate dynamic counters
const totalCount = apiPrograms.length;
const maestriasCount = apiPrograms.filter((p) => p.program_type === 1).length;
const doctoradosCount = apiPrograms.filter((p) => p.program_type === 2).length;

// Transform API data for UI
const displayPrograms = apiPrograms.map((apiProgram) => ({
  id: apiProgram.uuid,
  nombre: apiProgram.name,
  tipo: apiProgram.program_type === 2 ? 'doctorado' as const : 'maestria' as const,
  descripcion: apiProgram.description,
  descripcionCorta: apiProgram.description.slice(0, 150) + '...',
  slug: apiProgram.uuid,
  imagen: apiProgram.background,
  isActive: apiProgram.is_active,
}));

// Current filter for UI
const currentFilter = programType || 'todos';
---

<Layout 
  title="Programas Académicos"
  description="Descubre nuestra oferta de maestrías, doctorados, diplomados y cursos de especialización. Programas acreditados con docentes de alto nivel en Iquitos."
  keywords={["programas postgrado UNAP", "maestrías Iquitos", "doctorados Amazonía", "diplomados EPG", "cursos especialización Loreto"]}
>
  <Navbar client:load />
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-epg-navy to-epg-navy-light text-white py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="text-sm mb-4">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="text-gray-300 hover:text-white transition-colors">Inicio</a></li>
            <li class="text-gray-400">/</li>
            <li class="text-epg-gold">Programas Académicos</li>
          </ol>
        </nav>
        <div class="max-w-3xl">
          <h1 class="text-4xl md:text-5xl font-bold mb-4">
            Programas Académicos
          </h1>
          <p class="text-xl text-gray-300 mb-6">
            Descubre nuestra oferta de maestrías, doctorados y programas de formación continua diseñados para impulsar tu carrera profesional y contribuir al desarrollo de la región.
          </p>
          
          {hasError ? (
            <div class="bg-red-500/20 border border-red-500/50 rounded-lg px-4 py-3">
              <p class="text-red-200">No se pudieron cargar los contadores. Intente más tarde.</p>
            </div>
          ) : (
            <div class="flex flex-wrap gap-4">
              <div class="bg-white/10 backdrop-blur rounded-lg px-4 py-2">
                <span class="text-2xl font-bold text-epg-gold">{totalCount}</span>
                <span class="text-gray-300 ml-2">Programas activos</span>
              </div>
              <div class="bg-white/10 backdrop-blur rounded-lg px-4 py-2">
                <span class="text-2xl font-bold text-epg-gold">{maestriasCount}</span>
                <span class="text-gray-300 ml-2">Maestrías</span>
              </div>
              <div class="bg-white/10 backdrop-blur rounded-lg px-4 py-2">
                <span class="text-2xl font-bold text-epg-gold">{doctoradosCount}</span>
                <span class="text-gray-300 ml-2">Doctorados</span>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Lista de Programas -->
    <section class="py-12 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ProgramasLista 
          programs={displayPrograms}
          hasError={hasError}
          currentFilter={currentFilter}
          searchQuery={searchQuery}
          client:load 
        />
      </div>
    </section>
  </main>
</Layout>
