---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../features/navigation';
import { ContactForm } from '../../features/contacto';
---

<Layout 
  title="Contacto"
  description="Contáctanos para más información sobre programas de postgrado, admisión, trámites y servicios de la Escuela de Postgrado UNAP."
  keywords={["contacto EPG UNAP", "información postgrado Iquitos", "consultas maestría doctorado", "teléfono EPG UNAP"]}
>
  <Navbar client:load />
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-epg-navy via-epg-navy-light to-epg-navy-light text-white py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="text-sm mb-6">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="text-gray-300 hover:text-white transition-colors">Inicio</a></li>
            <li class="text-gray-400">/</li>
            <li class="text-epg-gold">Contacto</li>
          </ol>
        </nav>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Contáctanos</h1>
        <p class="text-xl text-gray-300 max-w-2xl">
          Estamos aquí para ayudarte. Comunícate con nosotros para cualquier consulta sobre nuestros programas de postgrado.
        </p>
      </div>
    </section>

    <!-- Content -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-3 gap-12">
          <!-- Contact Form -->
          <div class="lg:col-span-2">
            <ContactForm client:load />
          </div>

          <!-- Contact Info -->
          <div class="space-y-6">
            <!-- Información de contacto -->
            <div class="bg-white rounded-xl shadow-sm p-6">
              <h3 class="text-lg font-bold text-epg-navy mb-4">Información de contacto</h3>
              <div class="space-y-4">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-epg-navy/10 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-epg-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900">Dirección</p>
                    <p class="text-gray-600 text-sm">Calle Nauta 5ta cuadra<br/>Iquitos, Loreto - Perú</p>
                  </div>
                </div>

                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-epg-navy/10 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-epg-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900">Teléfono</p>
                    <a href="tel:+5165232241" class="text-gray-600 text-sm hover:text-epg-gold">(065) 232-241</a>
                  </div>
                </div>

                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-epg-navy/10 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-epg-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900">Correo electrónico</p>
                    <a href="mailto:epg@unapiquitos.edu.pe" class="text-gray-600 text-sm hover:text-epg-gold">epg@unapiquitos.edu.pe</a>
                  </div>
                </div>

                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-epg-navy/10 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-epg-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900">Horario de atención</p>
                    <p class="text-gray-600 text-sm">Lunes a Viernes<br/>8:00 a.m. - 4:00 p.m.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Redes sociales -->
            <div class="bg-white rounded-xl shadow-sm p-6">
              <h3 class="text-lg font-bold text-epg-navy mb-4">Síguenos</h3>
              <div class="flex gap-3">
                <a 
                  href="https://www.facebook.com/EPGUNAP" 
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 bg-epg-navy rounded-lg flex items-center justify-center hover:bg-epg-gold transition-colors group"
                >
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </a>
                <a 
                  href="https://www.youtube.com/@EscueladePostgradoUNAP" 
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 bg-epg-navy rounded-lg flex items-center justify-center hover:bg-epg-gold transition-colors group"
                >
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                </a>
                <a 
                  href="https://www.linkedin.com/company/epgunap" 
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 bg-epg-navy rounded-lg flex items-center justify-center hover:bg-epg-gold transition-colors group"
                >
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Mapa -->
            <div class="bg-white rounded-xl shadow-sm p-6">
              <h3 class="text-lg font-bold text-epg-navy mb-4">Ubicación</h3>
              <div class="aspect-video rounded-lg overflow-hidden bg-gray-200">
                <iframe 
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3984.096447754945!2d-73.25553442422837!3d-3.7492200961609!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x91ea10b60e8c5c25%3A0x8c4d7c0b0f5c0b0!2sUniversidad%20Nacional%20de%20la%20Amazon%C3%ADa%20Peruana!5e0!3m2!1ses!2spe!4v1700000000000!5m2!1ses!2spe"
                  width="100%"
                  height="100%"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Ubicación de la Escuela de Postgrado UNAP"
                ></iframe>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
