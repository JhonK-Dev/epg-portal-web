---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../features/navigation';
import { AdmisionContent } from '../../features/admision';
---

<Layout 
  title="Admisión 2025-I"
  description="Proceso de admisión para maestrías y doctorados en la EPG UNAP. Inscripciones abiertas. Conoce requisitos, cronograma y costos de postulación."
  keywords={["admisión postgrado UNAP", "inscripciones maestría Iquitos", "postular doctorado UNAP", "examen admisión EPG", "requisitos maestría Amazonía"]}
>
  <Navbar client:load />
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-[#0A1628] via-[#002a52] to-[#0D2240] text-white py-16 relative overflow-hidden">
      <!-- Background decoration -->
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 right-0 w-96 h-96 bg-[#D4A017] rounded-full blur-3xl transform translate-x-1/2 -translate-y-1/2"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-[#D4A017] rounded-full blur-3xl transform -translate-x-1/2 translate-y-1/2"></div>
      </div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Breadcrumb -->
        <nav class="text-sm mb-6">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="text-gray-300 hover:text-white transition-colors">Inicio</a></li>
            <li class="text-gray-400">/</li>
            <li class="text-[#D4A017]">Admisión</li>
          </ol>
        </nav>

        <div class="flex flex-col lg:flex-row items-center gap-12">
          <div class="flex-1">
            <div class="inline-flex items-center gap-2 bg-[#D4A017] text-[#0A1628] text-sm font-bold px-4 py-2 rounded-full mb-6">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#0A1628] opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-[#0A1628]"></span>
              </span>
              INSCRIPCIONES ABIERTAS
            </div>
            
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
              Admisión <span class="text-[#D4A017]">2025-I</span>
            </h1>
            
            <p class="text-xl text-gray-300 mb-8 max-w-2xl">
              Inicia tu camino hacia la excelencia académica. Forma parte de la Escuela de Posgrado más prestigiosa de la región sur del Perú.
            </p>
            
            <div class="flex flex-wrap gap-4 mb-8">
              <a 
                href="#inscribete" 
                class="bg-[#D4A017] text-[#0A1628] font-bold px-8 py-4 rounded-lg hover:bg-[#B8860B] transition-colors inline-flex items-center gap-2 shadow-lg hover:shadow-xl"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                Inscríbete ahora
              </a>
              <a 
                href="#requisitos" 
                class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors inline-flex items-center gap-2"
              >
                Ver requisitos
              </a>
            </div>

            <!-- Quick Stats -->
            <div class="flex flex-wrap gap-6">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-white/10 backdrop-blur rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6 text-[#D4A017]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                </div>
                <div>
                  <p class="text-2xl font-bold text-white">8</p>
                  <p class="text-sm text-gray-400">Programas disponibles</p>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-white/10 backdrop-blur rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6 text-[#D4A017]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                </div>
                <div>
                  <p class="text-2xl font-bold text-white">215</p>
                  <p class="text-sm text-gray-400">Vacantes totales</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Countdown Card -->
          <div class="lg:w-96">
            <div class="bg-white/10 backdrop-blur-lg rounded-2xl p-6 border border-white/20 shadow-2xl">
              <h3 class="text-lg font-semibold mb-6 flex items-center gap-2">
                <svg class="w-5 h-5 text-[#D4A017]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Fechas importantes
              </h3>
              <div class="space-y-4">
                <div class="flex items-center gap-4 p-3 bg-white/5 rounded-lg">
                  <div class="w-14 h-14 bg-[#D4A017] rounded-lg flex flex-col items-center justify-center text-[#0A1628]">
                    <span class="text-xl font-bold leading-none">15</span>
                    <span class="text-xs">ENE</span>
                  </div>
                  <div>
                    <p class="font-medium">Inicio de inscripciones</p>
                    <p class="text-sm text-gray-300">Admisión 2025-I</p>
                  </div>
                </div>
                <div class="flex items-center gap-4 p-3 bg-white/5 rounded-lg">
                  <div class="w-14 h-14 bg-white/20 rounded-lg flex flex-col items-center justify-center">
                    <span class="text-xl font-bold leading-none">28</span>
                    <span class="text-xs">FEB</span>
                  </div>
                  <div>
                    <p class="font-medium">Cierre de inscripciones</p>
                    <p class="text-sm text-gray-300">Fecha límite</p>
                  </div>
                </div>
                <div class="flex items-center gap-4 p-3 bg-white/5 rounded-lg">
                  <div class="w-14 h-14 bg-white/20 rounded-lg flex flex-col items-center justify-center">
                    <span class="text-xl font-bold leading-none">08</span>
                    <span class="text-xs">MAR</span>
                  </div>
                  <div>
                    <p class="font-medium">Examen de admisión</p>
                    <p class="text-sm text-gray-300">Sede principal</p>
                  </div>
                </div>
                <div class="flex items-center gap-4 p-3 bg-white/5 rounded-lg">
                  <div class="w-14 h-14 bg-white/20 rounded-lg flex flex-col items-center justify-center">
                    <span class="text-xl font-bold leading-none">01</span>
                    <span class="text-xs">ABR</span>
                  </div>
                  <div>
                    <p class="font-medium">Inicio de clases</p>
                    <p class="text-sm text-gray-300">Semestre 2025-I</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Navigation -->
    <section class="bg-white border-b sticky top-16 z-30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-1 overflow-x-auto py-4 scrollbar-hide">
          <a href="#cronograma" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-[#0A1628] hover:bg-gray-100 rounded-lg whitespace-nowrap transition-colors">
            Cronograma
          </a>
          <a href="#proceso" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-[#0A1628] hover:bg-gray-100 rounded-lg whitespace-nowrap transition-colors">
            Proceso
          </a>
          <a href="#programas" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-[#0A1628] hover:bg-gray-100 rounded-lg whitespace-nowrap transition-colors">
            Programas
          </a>
          <a href="#requisitos" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-[#0A1628] hover:bg-gray-100 rounded-lg whitespace-nowrap transition-colors">
            Requisitos
          </a>
          <a href="#costos" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-[#0A1628] hover:bg-gray-100 rounded-lg whitespace-nowrap transition-colors">
            Costos
          </a>
          <a href="#faq" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-[#0A1628] hover:bg-gray-100 rounded-lg whitespace-nowrap transition-colors">
            FAQ
          </a>
          <a href="#inscribete" class="ml-auto px-4 py-2 text-sm font-medium bg-[#D4A017] text-[#0A1628] rounded-lg whitespace-nowrap hover:bg-[#B8860B] transition-colors">
            ¡Inscríbete!
          </a>
        </nav>
      </div>
    </section>

    <!-- Main Content -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <AdmisionContent client:load />
      </div>
    </section>
  </main>
</Layout>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
