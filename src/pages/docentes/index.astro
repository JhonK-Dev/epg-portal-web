---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../features/navigation/components/Navbar.astro';
import { DocentesGrid } from '../../features/docentes';
---

<Layout 
  title="Nuestros Docentes"
  description="Conoce a los docentes de alto nivel académico de la Escuela de Postgrado UNAP. Doctores e investigadores comprometidos con la excelencia educativa."
  keywords={["docentes UNAP", "profesores postgrado Iquitos", "investigadores Amazonía", "plana docente EPG"]}
>
  <Navbar />
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="bg-linear-to-br from-epg-navy via-epg-navy-light to-epg-navy-light text-white py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="text-sm mb-6">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="text-gray-300 hover:text-white transition-colors">Inicio</a></li>
            <li class="text-gray-400">/</li>
            <li class="text-epg-gold">Docentes</li>
          </ol>
        </nav>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Nuestros Docentes</h1>
        <p class="text-xl text-gray-300 max-w-3xl leading-relaxed">
          Conoce a los profesionales de alto nivel académico que forman parte de nuestra planta docente, comprometidos con la excelencia en la formación de postgrado.
        </p>
      </div>
    </section>

    <!-- Content -->
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <DocentesGrid client:load />
      </div>
    </section>
  </main>
</Layout>
