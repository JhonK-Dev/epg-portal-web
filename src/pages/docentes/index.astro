---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../features/navigation';
import { DocentesGrid } from '../../features/docentes';
---

<Layout title="Nuestros Docentes - EPG UNAP">
  <Navbar client:load />
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-[#001F3F] via-[#002855] to-[#003366] text-white py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="text-sm mb-6">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="text-gray-300 hover:text-white transition-colors">Inicio</a></li>
            <li class="text-gray-400">/</li>
            <li class="text-[#E6A817]">Docentes</li>
          </ol>
        </nav>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Nuestros Docentes</h1>
        <p class="text-xl text-gray-300 max-w-3xl leading-relaxed">
          Conoce a los profesionales de alto nivel académico que forman parte de nuestra planta docente, comprometidos con la excelencia en la formación de postgrado.
        </p>
      </div>
    </section>

    <!-- Content -->
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <DocentesGrid client:load />
      </div>
    </section>
  </main>
</Layout>
