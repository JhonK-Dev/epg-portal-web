---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../features/navigation/components/Navbar.astro';
import { DocenteDetail } from '../../features/docentes';
import { docentes, getDocenteById, getAllDocenteIds } from '../../data/docentes';

export function getStaticPaths() {
  return docentes.map((docente) => ({
    params: { id: docente.id },
    props: { docente },
  }));
}

const { id } = Astro.params;
const { docente } = Astro.props;

if (!docente) {
  return Astro.redirect('/404');
}

const gradoLabels: Record<string, string> = {
  doctor: 'Dr.',
  phd: 'Ph.D.',
  magister: 'Mg.',
  bachiller: 'Bach.',
};

const nombreCompleto = `${gradoLabels[docente.grado] || ''} ${docente.nombres} ${docente.apellidos}`;
---

<Layout 
  title={`${nombreCompleto} | Docentes`}
  description={docente.resumenPerfil || `Perfil del docente ${nombreCompleto} de la Escuela de Postgrado de la UNAP.`}
  keywords={[`${docente.nombres} ${docente.apellidos}`, docente.especialidad, "docente UNAP", "investigador postgrado"]}
  type="article"
>
  <Navbar />
  <main class="min-h-screen">
    <DocenteDetail client:load docente={docente} />
  </main>
</Layout>
