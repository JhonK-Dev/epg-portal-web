---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../features/navigation/components/Navbar.astro';
import { PublicacionDetail } from '../../features/publicaciones';
import { publicaciones, getPublicacionBySlug, getUltimasPublicaciones } from '../../data/publicaciones';

export async function getStaticPaths() {
  return publicaciones.map((publicacion) => ({
    params: { slug: publicacion.slug },
    props: { publicacion },
  }));
}

const { slug } = Astro.params;
const { publicacion } = Astro.props;

// Fallback in case props don't work as expected
const publicacionData = publicacion || getPublicacionBySlug(slug);

if (!publicacionData) {
  return Astro.redirect('/404');
}

// Get related publications (same type, excluding current)
const relacionadas = publicaciones
  .filter(p => p.tipo === publicacionData.tipo && p.id !== publicacionData.id)
  .slice(0, 3);

const tipoLabels: Record<string, string> = {
  noticia: 'Noticia',
  evento: 'Evento',
  aviso: 'Aviso',
  comunicado: 'Comunicado',
};
---

<Layout 
  title={publicacionData.titulo}
  description={publicacionData.resumen}
  type="article"
  publishedTime={publicacionData.fecha}
  keywords={[tipoLabels[publicacionData.tipo], "EPG UNAP", "noticias postgrado", publicacionData.categoria || "educación"]}
>
  <Navbar />
  <main>
    <PublicacionDetail 
      publicacion={publicacionData} 
      publicacionesRelacionadas={relacionadas}
      client:load 
    />
  </main>
</Layout>
