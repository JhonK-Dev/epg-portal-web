---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../features/navigation';
import { PublicacionesLista } from '../../features/publicaciones';
---

<Layout 
  title="Noticias y Eventos"
  description="Mantente informado sobre las últimas novedades, eventos académicos y comunicados oficiales de la Escuela de Postgrado UNAP."
  keywords={["noticias EPG UNAP", "eventos postgrado", "comunicados universidad", "novedades académicas Iquitos"]}
>
  <Navbar client:load />
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-[#001F3F] via-[#002855] to-[#003366] text-white py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="text-sm mb-6">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="text-gray-300 hover:text-white transition-colors">Inicio</a></li>
            <li class="text-gray-400">/</li>
            <li class="text-[#E6A817]">Publicaciones</li>
          </ol>
        </nav>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Noticias y Eventos</h1>
        <p class="text-xl text-gray-300 max-w-3xl leading-relaxed">
          Mantente informado sobre las últimas novedades, eventos académicos y comunicados oficiales de la Escuela de Postgrado.
        </p>
      </div>
    </section>

    <!-- Content -->
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <PublicacionesLista client:load />
      </div>
    </section>
  </main>
</Layout>
