---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../features/navigation';
import { contactoGeneral } from '../data/contacto';
---

<Layout 
  title="Página no encontrada"
  description="La página que buscas no existe o ha sido movida. Visita nuestra página principal para encontrar lo que necesitas."
  noindex={true}
>
  <Navbar client:load />
  <main class="min-h-[calc(100vh-200px)] flex items-center justify-center bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <!-- Ilustración 404 -->
      <div class="relative mb-8">
        <div class="text-[150px] md:text-[200px] font-bold text-gray-100 select-none leading-none">
          404
        </div>
        <div class="absolute inset-0 flex items-center justify-center">
<div class="w-32 h-32 md:w-40 md:h-40 bg-gradient-to-br from-epg-navy to-epg-navy-light rounded-full flex items-center justify-center shadow-2xl">
            <svg 
              class="w-16 h-16 md:w-20 md:h-20 text-epg-gold"
              fill="none" 
              stroke="currentColor" 
              viewBox="0 0 24 24"
            >
              <path 
                stroke-linecap="round" 
                stroke-linejoin="round" 
                stroke-width="1.5" 
                d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
        </div>
      </div>

      <!-- Mensaje -->
      <h1 class="text-3xl md:text-4xl font-bold text-epg-navy mb-4">
        ¡Oops! Página no encontrada
      </h1>
      <p class="text-lg text-gray-600 mb-8 max-w-md mx-auto">
        Lo sentimos, la página que buscas no existe o ha sido movida a otra ubicación.
      </p>

      <!-- Botón principal -->
      <a 
        href="/" 
        class="inline-flex items-center gap-2 bg-epg-navy text-white font-semibold px-8 py-4 rounded-lg hover:bg-epg-navy-light transition-colors shadow-lg hover:shadow-xl"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Volver al Inicio
      </a>

      <!-- Separador -->
      <div class="my-10 flex items-center justify-center">
        <div class="w-16 h-px bg-gray-300"></div>
        <span class="mx-4 text-gray-400 text-sm">o visita</span>
        <div class="w-16 h-px bg-gray-300"></div>
      </div>

      <!-- Links populares -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a 
          href="/programas" 
          class="group p-4 bg-white rounded-xl border border-gray-200 hover:border-epg-gold hover:shadow-md transition-all"
        >
          <div class="w-10 h-10 bg-epg-navy/10 rounded-lg flex items-center justify-center mx-auto mb-2 group-hover:bg-epg-gold/10 transition-colors">
            <svg class="w-5 h-5 text-epg-navy group-hover:text-epg-gold transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-700 group-hover:text-epg-navy">Programas</span>
        </a>

        <a 
          href="/admision" 
          class="group p-4 bg-white rounded-xl border border-gray-200 hover:border-epg-gold hover:shadow-md transition-all"
        >
          <div class="w-10 h-10 bg-epg-navy/10 rounded-lg flex items-center justify-center mx-auto mb-2 group-hover:bg-epg-gold/10 transition-colors">
            <svg class="w-5 h-5 text-epg-navy group-hover:text-epg-gold transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-700 group-hover:text-epg-navy">Admisión</span>
        </a>

        <a 
          href="/publicaciones" 
          class="group p-4 bg-white rounded-xl border border-gray-200 hover:border-epg-gold hover:shadow-md transition-all"
        >
          <div class="w-10 h-10 bg-epg-navy/10 rounded-lg flex items-center justify-center mx-auto mb-2 group-hover:bg-epg-gold/10 transition-colors">
            <svg class="w-5 h-5 text-epg-navy group-hover:text-epg-gold transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-700 group-hover:text-epg-navy">Noticias</span>
        </a>

        <a 
          href="/servicios" 
          class="group p-4 bg-white rounded-xl border border-gray-200 hover:border-epg-gold hover:shadow-md transition-all"
        >
          <div class="w-10 h-10 bg-epg-navy/10 rounded-lg flex items-center justify-center mx-auto mb-2 group-hover:bg-epg-gold/10 transition-colors">
            <svg class="w-5 h-5 text-epg-navy group-hover:text-epg-gold transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-700 group-hover:text-epg-navy">Servicios</span>
        </a>
      </div>

      <!-- Info de contacto -->
      <div class="mt-12 p-6 bg-gray-50 rounded-xl">
        <p class="text-sm text-gray-600 mb-3">
          ¿Necesitas ayuda? Contáctanos:
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a 
            href={`mailto:${contactoGeneral.email}`}
            class="inline-flex items-center gap-2 text-sm text-epg-navy hover:text-epg-gold transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {contactoGeneral.email}
          </a>
          <a 
            href={`tel:${contactoGeneral.telefono}`}
            class="inline-flex items-center gap-2 text-sm text-epg-navy hover:text-epg-gold transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {contactoGeneral.telefonoDisplay}
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
